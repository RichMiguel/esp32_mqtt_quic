  {
    "id": "ui_template_status",
    "type": "ui_template",
    "z": "tab_air_quality",
    "group": "ui_group_quic_status",
    "name": "Badge Transport QUIC",
    "order": 1,
    "width": "6",
    "height": "6",
    "format": "<div style=\"padding:12px; border-radius:10px; background:linear-gradient(135deg, #0d324d 0%, #1a5276 100%); color:#ffffff; font-family:sans-serif;\">\n  <div style=\"display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;\">\n    <span style=\"font-size:16px; font-weight:bold; color:#58d68d;\">⚡ MQTT over QUIC</span>\n    <span style=\"background:#27ae60; padding:2px 8px; border-radius:12px; font-size:11px;\">TERHUBUNG</span>\n  </div>\n  <p style=\"margin:4px 0; font-size:12px;\"><b>Upstream EMQX:</b> <code>broker.emqx.io:14567 (UDP)</code></p>\n  <p style=\"margin:4px 0; font-size:12px;\"><b>Local Edge:</b> <code>NanoMQ (Port 1885)</code></p>\n  <p style=\"margin:4px 0; font-size:12px;\"><b>Topik Sub:</b> <code>sensor/air_quality/remote</code></p>\n  <hr style=\"border:0; border-top:1px solid rgba(255,255,255,0.2); margin:8px 0;\">\n  <p style=\"margin:4px 0; font-size:12px;\"><b>Device ID:</b> {{msg.payload.device}}</p>\n  <p style=\"margin:4px 0; font-size:12px;\"><b>Uptime ESP32:</b> {{msg.payload.uptime}} detik</p>\n  <p style=\"margin:6px 0 0 0; font-size:11px; color:#85c1e9;\"><i>Data ini berhasil memantul kembali dari EMQX Cloud via QUIC</i></p>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 730,
    "y": 100,
    "wires": [
      []
    ]
  },
  {
    "id": "fn_dust_gauge",
    "type": "function",
    "z": "tab_air_quality",
    "name": "Extract Dust",
    "func": "const val = msg.payload.dust ? msg.payload.dust.ug_m3 : 0;\nreturn [\n  { payload: val }, // Ke Gauge\n  { topic: 'Debu (ug/m3)', payload: val } // Ke Chart\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 180,
    "wires": [
      [
        "ui_gauge_dust"
      ],
      [
        "ui_chart_realtime"
      ]
    ]
  },
